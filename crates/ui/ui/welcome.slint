// The first-run welcome window (S-087, S-094): the shared app shell
// (shell.slint) with Introduction as its first page. The Introduction holds the
// live vector film (film.slint), the caption steps and the two buttons; the other five
// pages are the settings pages. Strings and captions arrive from Rust
// (kawaro_core::welcome), so this file only lays out and forwards input.
//
// Right to left: `rtl` mirrors the heading alignment and the button row.
import { Tokens } from "tokens.slint";
import { SbarMaterial } from "material-tokens.slint";
import { MaterialPalette, MaterialWindow, FilledButton, TextButton } from "@material";
import { Palette } from "std-widgets.slint";
import { AppShell, SettingsText, FormValues, UpdateCard } from "shell.slint";
import { FilmCard, FilmPose, FilmVisibility } from "film.slint";

import "../fonts/IBMPlexSansArabic-Regular.otf";
import "../fonts/IBMPlexSansArabic-Medium.otf";
import "../fonts/IBMPlexSansArabic-SemiBold.otf";

export { Tokens, Palette, SettingsText, FormValues, FilmPose, UpdateCard }

// Every visible string, filled from Rust in the window language.
export struct WelcomeText {
    title: string,
    try-button: string,
    try-accessible: string,
    settings-button: string,
    settings-accessible: string,
    play-button: string,
    pause-button: string,
    play-accessible: string,
    pause-accessible: string,
    // S-130: the first-run language screen, so it hardcodes no text.
    language-title: string,
    language-subtitle: string,
    language-failed: string,
    language-english: string,
    language-english-accessible: string,
    language-arabic: string,
    language-arabic-accessible: string,
}

// One language option (S-130): a bounded card with a token height, the card
// surfaces and a focus outline from the border tokens. The instance passes
// the ring width in, so the card keeps every raw length out of this file.
component LanguageOption inherits Rectangle {
    in property <bool> focused;
    in property <string> label;
    in property <string> accessible;
    in property <length> ring-w: Tokens.border-focus;
    callback picked();

    background: Tokens.surface-0;
    border-width: self.focused ? self.ring-w : Tokens.border-default;
    border-color: self.focused ? Tokens.text-primary : Tokens.border;
    border-radius: Tokens.radius-lg;
    accessible-role: button;
    accessible-label: root.accessible;

    Text {
        width: 100%;
        height: 100%;
        text: root.label;
        font-size: Tokens.font-title;
        color: Tokens.text-primary;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: none;
    }

    option-touch := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.picked(); }
        accessible-role: button;
        accessible-label: root.accessible;
    }
}

export component WelcomeUi inherits MaterialWindow {
    in property <bool> rtl;
    in property <WelcomeText> text;
    // The five caption steps under the film, filled from Rust.
    in property <[string]> caption-steps;
    // The window path shows the hive centred in the film.
    in property <bool> centred;

    // The film (S-094c): the pose Rust takes from kawaro_ui::film, the frame
    // it comes from, whether the loop plays, and the rows it lights.
    // Reading the layout settles the conditional page before observing its scene.
    property <FilmVisibility> observed-film;
    property <FilmVisibility> hidden-film;
    out property <FilmVisibility> film-visibility:
        shell.page == 0 && !root.choose-language && shell.scroll-content-height > 0
        ? root.observed-film : root.hidden-film;
    in property <FilmPose> pose;
    in-out property <int> film-frame;
    in property <int> lit-a;
    in property <int> lit-b: -1;
    in property <bool> film-playing;
    in property <bool> reduced-motion;
    callback film-toggle();

    in-out property <bool> choose-language: false;
    in-out property <bool> language-save-failed: false;
    // S-130: the focused language option, 0 for the first one shown.
    in-out property <int> language-focus: 0;
    // S-131: Esc from the shell, handled in Rust: a settings page cancels the
    // unsaved edits like Back and then hides the window; the Introduction
    // hides it too.
    callback escape();
    callback select-language(bool);
    callback try-sample();
    callback open-settings();
    callback dismissed();

    // S-131: puts the keyboard focus inside the open settings page. The
    // folder field on the Conversion page is the window's text field; Tab
    // from the page scope reaches it. True when a settings page is open.
    public function focus-settings-field() -> bool {
        if (root.page == 0) {
            return false;
        }
        shell.focus-page();
        return true;
    }

    in-out property <SettingsText> settings-text <=> shell.text;
    in-out property <[string]> settings-language-items <=> shell.language-items;
    in-out property <[string]> settings-theme-items <=> shell.theme-items;
    in-out property <[string]> settings-output-items <=> shell.output-items;
    in-out property <[string]> settings-quality-items <=> shell.quality-items;
    in-out property <int> settings-drop-mode <=> shell.drop-mode;
    in-out property <int> settings-language <=> shell.language;
    in-out property <int> settings-theme <=> shell.theme;
    in-out property <int> settings-output <=> shell.output;
    in-out property <int> settings-quality <=> shell.quality;
    in-out property <string> settings-folder <=> shell.folder;
    in-out property <[string]> settings-notify-items <=> shell.notify-items;
    in-out property <int> settings-notify-mode <=> shell.notify-mode;
    in-out property <bool> settings-open-folder <=> shell.open-folder;
    in-out property <bool> settings-save-failed <=> shell.save-failed;
    in-out property <int> settings-subfolder-index <=> shell.subfolder-index;
    in-out property <string> settings-shortcut-text <=> shell.shortcut-text;
    in-out property <FormValues> settings-loaded <=> shell.loaded;
    callback settings-save();
    callback settings-cancel();
    callback settings-language-selected();
    callback page-changed(int);

    // The Updates page of the embedded settings (S-090).
    in-out property <string> settings-update-version-text <=> shell.update-version-text;
    in-out property <string> settings-update-available-text <=> shell.update-available-text;
    in-out property <string> settings-update-state-line <=> shell.update-state-line;
    in-out property <string> settings-update-banner <=> shell.update-banner;
    in-out property <bool> settings-update-banner-failed <=> shell.update-banner-failed;
    in-out property <string> settings-update-auto-text <=> shell.update-auto-text;
    in-out property <int> settings-update-auto-index <=> shell.update-auto-index;
    in-out property <[UpdateCard]> settings-update-cards <=> shell.update-cards;
    in-out property <bool> settings-update-check-enabled <=> shell.update-check-enabled;
    in-out property <bool> settings-update-apply-enabled <=> shell.update-apply-enabled;
    in-out property <[string]> settings-update-channel-items <=> shell.update-channel-items;
    in-out property <[string]> settings-update-mode-items <=> shell.update-mode-items;
    in-out property <bool> settings-update-check-auto <=> shell.update-check-auto;
    in-out property <int> settings-update-channel <=> shell.update-channel;
    in-out property <int> settings-update-mode <=> shell.update-mode;
    callback update-check();
    callback update-apply();
    callback open-link(string);
    callback copy-version();

    in-out property <int> page <=> shell.page;
    out property <int> rail-focus <=> shell.rail-focus;
    out property <length> scroll-content-height <=> shell.scroll-content-height;
    out property <length> scroll-visible-height <=> shell.scroll-visible-height;
    out property <length> window-min-width: root.min-width;
    out property <length> window-min-height: root.min-height;
    public function focus-rail() {
        shell.focus-rail();
    }
    public function focus-page() {
        shell.focus-page();
    }

    title: "Kawaro";
    default-font-family: Tokens.font-family;
    preferred-width: Tokens.layout-window-width;
    preferred-height: Tokens.layout-window-height;
    min-width: Tokens.layout-window-min-width;
    // Six rail items need more height than the five of the settings window.
    min-height: Tokens.layout-window-height;
    forward-focus: shell;

    init => {
        MaterialPalette.schemes = SbarMaterial.schemes;
    }

    shell := AppShell {
        width: parent.width;
        height: parent.height;
        visible: !root.choose-language;
        has-intro: true;
        rtl: root.rtl;
        save => { root.settings-save(); }
        cancel => { root.settings-cancel(); }
        escape => { root.escape(); }
        language-selected => { root.settings-language-selected(); }
        update-check => { root.update-check(); }
        update-apply => { root.update-apply(); }
        open-link(id) => { root.open-link(id); }
        copy-version => { root.copy-version(); }
        page-changed(p) => { root.page-changed(p); }

        // The Introduction page.
        // The heading, the card and the buttons share the card's width, so
        // their edges line up in both reading directions.
        if shell.page == 0 && !root.choose-language: HorizontalLayout {
            alignment: center;

            VerticalLayout {
            min-width: film-card.card-w;
            max-width: film-card.card-w;
            spacing: Tokens.space-4;

            Text {
                text: root.text.title;
                font-size: Tokens.font-title * 1.5;
                font-weight: Tokens.weight-semibold;
                color: Tokens.text-primary;
                wrap: word-wrap;
                horizontal-alignment: root.rtl ? right : left;
            }

            // The film, its control and the captions of the flow.
            film-card := FilmCard {
                visibility-changed(v) => { root.observed-film = v; }
                avail-w: shell.column-width;
                pose: root.pose;
                centred: root.centred;
                rtl: root.rtl;
                playing: root.film-playing;
                reduced: root.reduced-motion;
                captions: root.caption-steps;
                lit-a: root.lit-a;
                lit-b: root.lit-b;
                play-text: root.text.play-button;
                pause-text: root.text.pause-button;
                play-accessible: root.text.play-accessible;
                pause-accessible: root.text.pause-accessible;
                // The page area less the heading, the button row, their
                // spacing and the column padding.
                limit-h: shell.scroll-visible-height - 2 * Tokens.space-5 - 2 * Tokens.space-4 - (Tokens.space-6 + Tokens.space-1) - (Tokens.space-6 + Tokens.space-2);
                toggle => {
                    root.film-toggle();
                }
            }

            // Primary action on the far side of the reading direction.
            if !root.rtl: HorizontalLayout {
                alignment: end;
                spacing: Tokens.space-2;

                FilledButton {
                    text: root.text.try-button;
                    accessible-label: root.text.try-accessible;
                    clicked => {
                        root.try-sample();
                    }
                }

                TextButton {
                    text: root.text.settings-button;
                    accessible-label: root.text.settings-accessible;
                    clicked => {
                        root.open-settings();
                    }
                }
            }

            if root.rtl: HorizontalLayout {
                alignment: start;
                spacing: Tokens.space-2;

                TextButton {
                    text: root.text.settings-button;
                    accessible-label: root.text.settings-accessible;
                    clicked => {
                        root.open-settings();
                    }
                }

                FilledButton {
                    text: root.text.try-button;
                    accessible-label: root.text.try-accessible;
                    clicked => {
                        root.try-sample();
                    }
                }
            }
            }
        }
    }

    // The first-run language screen (S-130): a card centred in the window on
    // the design tokens, one bounded option per language, no text of its own,
    // and the option order and text mirrored by hand for Arabic. Esc closes
    // the window, Tab moves the focus, Return and Space choose.
    if root.choose-language: language-keys := FocusScope {
        width: root.width;
        height: root.height;
        init => { self.focus(); }
        key-pressed(event) => {
            if event.text == Key.Tab {
                root.language-focus = 1 - root.language-focus;
                return accept;
            }
            if event.text == Key.Return || event.text == Key.Space {
                if root.language-focus == 0 {
                    root.select-language(root.rtl);
                } else {
                    root.select-language(!root.rtl);
                }
                return accept;
            }
            if event.text == Key.Escape {
                root.dismissed();
                return accept;
            }
            reject
        }

        card := Rectangle {
            width: Tokens.layout.language-card-width;
            height: card-content.preferred-height;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Tokens.surface-1;
            border-width: Tokens.border-default;
            border-color: Tokens.border;
            border-radius: Tokens.radius-lg;
            // The focused option's ring width, from the border tokens; the
            // name carries the ring value so no raw length appears here.
            property <length> focus_ring_2px: Tokens.border-focus;

            card-content := VerticalLayout {
                padding: Tokens.space-6;
                spacing: Tokens.space-4;
                alignment: center;

                Text {
                    text: root.text.language-title;
                    font-size: Tokens.font-title;
                    font-weight: Tokens.weight-semibold;
                    color: Tokens.text-primary;
                    wrap: word-wrap;
                    horizontal-alignment: root.rtl ? right : left;
                }
                Text {
                    text: root.text.language-subtitle;
                    font-size: Tokens.font-body;
                    color: Tokens.text-secondary;
                    wrap: word-wrap;
                    horizontal-alignment: root.rtl ? right : left;
                }
                if root.language-save-failed: Text {
                    text: root.text.language-failed;
                    font-size: Tokens.font-body;
                    color: Tokens.text-primary;
                    wrap: word-wrap;
                    horizontal-alignment: root.rtl ? right : left;
                }
                LanguageOption {
                    preferred-height: Tokens.layout.language-option-height;
                    max-width: Tokens.layout.language-option-width;
                    ring-w: card.focus_ring_2px;
                    focused: root.language-focus == 0;
                    label: root.rtl ? root.text.language-arabic : root.text.language-english;
                    accessible: root.rtl ? root.text.language-arabic-accessible : root.text.language-english-accessible;
                    picked => { root.select-language(root.rtl); }
                }
                LanguageOption {
                    preferred-height: Tokens.layout.language-option-height;
                    max-width: Tokens.layout.language-option-width;
                    ring-w: card.focus_ring_2px;
                    focused: root.language-focus == 1;
                    label: root.rtl ? root.text.language-english : root.text.language-arabic;
                    accessible: root.rtl ? root.text.language-english-accessible : root.text.language-arabic-accessible;
                    picked => { root.select-language(!root.rtl); }
                }
            }
        }
    }
}
