// The settings window: a normal decorated window built from the vendored
// Material 3 components (crates/ui/material, see its README and
// docs/adr/0002-settings-components.md) inside the shared app shell
// (shell.slint, S-094). Strings, option order and the mapping to the settings
// file live in Rust (src/settings.rs); this file only forwards.
//
// Right to left: Rust reverses the option lists for Arabic, and the shell
// mirrors the rail, the header, the rows and the footer.
import { Tokens } from "tokens.slint";
import { SbarMaterial } from "material-tokens.slint";
import { MaterialPalette, MaterialWindow } from "@material";
import { Palette } from "std-widgets.slint";
import { AppShell, SettingsText, FormValues, UpdateCard } from "shell.slint";

import "../fonts/IBMPlexSansArabic-Regular.otf";
import "../fonts/IBMPlexSansArabic-Medium.otf";
import "../fonts/IBMPlexSansArabic-SemiBold.otf";

export { Tokens, Palette, SettingsText, FormValues, UpdateCard }

export component SettingsUi inherits MaterialWindow {
    forward-focus: shell;
    in-out property <bool> rtl <=> shell.rtl;
    in-out property <SettingsText> text <=> shell.text;
    in-out property <[string]> language-items <=> shell.language-items;
    in-out property <[string]> theme-items <=> shell.theme-items;
    in-out property <[string]> output-items <=> shell.output-items;
    in-out property <[string]> quality-items <=> shell.quality-items;
    in-out property <int> language <=> shell.language;
    in-out property <int> theme <=> shell.theme;
    in-out property <int> output <=> shell.output;
    in-out property <int> quality <=> shell.quality;
    in-out property <string> folder <=> shell.folder;
    in-out property <bool> notify <=> shell.notify;
    in-out property <bool> notify-long-only <=> shell.notify-long-only;
    in-out property <bool> save-failed <=> shell.save-failed;
    in-out property <bool> open-folder <=> shell.open-folder;
    in-out property <int> subfolder-index <=> shell.subfolder-index;
    in-out property <string> update-version-text <=> shell.update-version-text;
    in-out property <string> update-available-text <=> shell.update-available-text;
    in-out property <string> update-state-line <=> shell.update-state-line;
    in-out property <string> update-banner <=> shell.update-banner;
    in-out property <bool> update-banner-failed <=> shell.update-banner-failed;
    in-out property <string> update-auto-text <=> shell.update-auto-text;
    in-out property <int> update-auto-index <=> shell.update-auto-index;
    out property <string> update-auto-notice <=> shell.update-auto-notice;
    in-out property <[UpdateCard]> update-cards <=> shell.update-cards;
    in-out property <bool> update-check-enabled <=> shell.update-check-enabled;
    in-out property <bool> update-apply-enabled <=> shell.update-apply-enabled;
    in-out property <[string]> update-channel-items <=> shell.update-channel-items;
    in-out property <[string]> update-mode-items <=> shell.update-mode-items;
    in-out property <bool> update-check-auto <=> shell.update-check-auto;
    in-out property <int> update-channel <=> shell.update-channel;
    in-out property <int> update-mode <=> shell.update-mode;
    in-out property <string> shortcut-text <=> shell.shortcut-text;
    in-out property <FormValues> loaded <=> shell.loaded;
    in-out property <int> page <=> shell.page;
    out property <int> rail-focus <=> shell.rail-focus;
    out property <length> scroll-content-height <=> shell.scroll-content-height;
    out property <length> scroll-visible-height <=> shell.scroll-visible-height;
    out property <length> window-min-width: root.min-width;
    out property <length> window-min-height: root.min-height;
    callback save();
    callback cancel();
    callback language-selected();
    callback update-check();
    callback update-apply();
    callback page-changed(int);
    public function focus-rail() {
        shell.focus-rail();
    }
    title: "Kawaro";
    default-font-family: Tokens.font-family;
    preferred-width: Tokens.layout-window-width;
    preferred-height: Tokens.layout-window-height;
    min-width: Tokens.layout-window-min-width;
    min-height: Tokens.layout-window-min-height;
    init => { MaterialPalette.schemes = SbarMaterial.schemes; }
    shell := AppShell {
        width: parent.width;
        height: parent.height;
        save => { root.save(); }
        cancel => { root.cancel(); }
        escape => { root.cancel(); }
        language-selected => { root.language-selected(); }
        update-check => { root.update-check(); }
        update-apply => { root.update-apply(); }
        page-changed(p) => { root.page-changed(p); }
    }
}
