// The hive popup: a frameless transparent window holding the centre cell and
// up to 18 action cells. Geometry (cell centres, picking, keyboard order)
// is computed in Rust (src/layout.rs); this file only draws and forwards input.
import { Tokens } from "tokens.slint";
import { SbarMaterial } from "material-tokens.slint";
import { HexCell } from "../components/hex-cell.slint";
// The vendored Material 3 controls of the stage 2 panel (S-119). Every colour
// comes from the design tokens through the generated Material palette.
import { MaterialPalette, CheckBox, CheckState, FilledButton, FilterChip, RadioButton, ScrollView, Slider, TextButton, TextField } from "../material/material.slint";

// Embedded so the hive never depends on system fonts.
import "../fonts/IBMPlexSansArabic-Regular.otf";
import "../fonts/IBMPlexSansArabic-Medium.otf";
import "../fonts/IBMPlexSansArabic-SemiBold.otf";

export { Tokens }

export struct CellData {
    x: length,
    y: length,
    code: string,
    label: string,
    icon: image,
    has-icon: bool,
    // The cell's slot ring (axial distance from the centre), for the
    // ring-by-ring open (S-017).
    ring: int,
    // False for a skipped file (S-108); `reason` shows in the centre on
    // hover when it is not empty.
    enabled: bool,
    reason: string,
    // S-119: the action carries `[action.options]`, so it has a stage 2 panel.
    customize: bool,
}

// S-119 stage 2: one option row, built from the action's option schema.
export enum StageKind {
    Bool,
    Enum,
    Number,
    Text,
}

export struct SegmentChoice {
    text: string,
}

export struct StageOption {
    id: string,
    label: string,
    unit: string,
    // The formatted value with its unit (or the selected choice label), for
    // the label line and the accessible labels.
    display: string,
    kind: StageKind,
    value: float,
    text: string,
    min: float,
    max: float,
    step: float,
    choices: [SegmentChoice],
    selected: int,
}

export struct StagePreset {
    id: string,
    label: string,
}

export component HiveWindow inherits Window {
    in property <[CellData]> cells;
    in property <length> hex-r;
    in property <length> centre-x;
    in property <length> centre-y;
    in property <length> win-w;
    in property <length> win-h;
    in property <string> centre-text;
    in property <string> centre-label;
    // The reason line and the suggestion of an unsupported selection
    // (S-108): their own elements, never part of the centre text.
    in property <string> centre-message;
    in property <string> centre-suggestion;
    // The text the centre cell draws: the highlighted cell's reason, else
    // its label, else (no highlight) the centre text (S-108).
    out property <string> centre-shown: root.hovering ? (root.cells[root.highlight].reason != "" ? root.cells[root.highlight].reason : root.cells[root.highlight].label) : (root.preview-count > 0 ? "" : root.centre-text);
    // Arabic: the stack and the count go to the other side (S-018 AC25).
    in property <bool> rtl;
    // The selected files in the centre (S-018h). `preview-image` is a cached
    // thumbnail already downscaled in Rust; without one, `preview-icon` and
    // `preview-code` show the files' kind. No files: count 0, no preview.
    in property <image> preview-image;
    in property <image> preview-icon;
    in property <string> preview-code;
    in property <int> preview-count;
    // Index into `cells` of the highlighted cell (mouse or keyboard), or -1.
    in-out property <int> highlight: -1;
    // False then true again on every present, to replay the opening scale.
    in-out property <bool> opened: true;
    // True during the 90 ms close (S-017c): the hive fades and shrinks over
    // `Tokens.hive-close` before the window hides.
    in-out property <bool> closing: false;
    // Glass surfaces (`Tokens.glass-2` and `Tokens.glass-3`), on only over
    // a compositor blur (S-017 AC13); opaque everywhere else.
    in-out property <bool> glass: false;
    // X11 only (S-113): an opaque `surface-0` plate under the hive, because
    // an X11 session has no compositor to count on. No shadow, no gradient,
    // no transparency.
    in property <bool> x11-plate: false;
    // S-119 stage 2: the option panel replaces the hive content in the same
    // window, so no new window opens and focus cannot be stolen. The panel
    // draws only after the user asks for it.
    in-out property <bool> stage-two: false;
    in property <string> stage-title;
    in property <string> stage-readout;
    in property <bool> stage-preview;
    in property <image> stage-preview-image;
    in property <[StageOption]> stage-options;
    in property <[StagePreset]> stage-presets;
    in property <string> stage-run-text;
    in property <string> stage-reset-text;
    in property <string> stage-back-text;
    // S-119: the resolved params failure, shown in the danger colour while
    // the panel stays open; empty when the values are valid.
    in property <string> stage-error;
    // "Preview not available" when an image source has no usable picture.
    in property <string> stage-preview-note;
    // S-119: the pill under the centre label that opens the panel for the
    // highlighted cell, its text from the daemon.
    in property <string> customize-hint;
    // Which cell's hint pill is showing; it stays while the pointer is over
    // the pill itself, so the pill is clickable.
    property <int> hinted-cell: -1;
    property <bool> hint-visible: root.hinted-cell >= 0 && root.customize-hint != "";

    // Keeps the pill only while a customizable cell or the pill is under the
    // pointer. The pill is the guaranteed door on every backend (the window
    // backends report no double clicks), Shift+Return is its keyboard form.
    function update-hint(index: int) {
        if (index >= 0 && index < root.cells.length) {
            if (root.cells[index].customize) {
                root.hinted-cell = index;
                return;
            }
        }
        if (!pill-touch.has-hover) {
            root.hinted-cell = -1;
        }
    }

    // Index into `cells` under the point, -1 for nothing.
    callback pick(length, length) -> int;
    // Next highlight for a key code (see layout::Nav::from_code).
    callback navigate(int, int) -> int;
    callback choose(int);
    callback dismiss();
    // S-119: the customize pill under the centre label, and the panel.
    callback customize(int);
    callback stage-run();
    callback stage-reset();
    callback stage-cancel();
    callback option-changed(index: int, numeric: float, text: string);
    callback preset-picked(index: int);

    init => { MaterialPalette.schemes = SbarMaterial.schemes; }

    no-frame: true;
    background: transparent;
    title: "Kawaro";
    width: root.win-w;
    height: root.win-h;
    default-font-family: Tokens.font-family;
    forward-focus: keys;

    // A cell under the pointer or the keyboard: the centre shows its name.
    property <bool> hovering: root.highlight >= 0 && root.highlight < root.cells.length;
    // Side of the square inscribed in the centre hexagon: (3 - sqrt 3) r.
    property <length> preview-side: root.hex-r * 1.2679492;
    property <bool> has-thumb: root.preview-image.width > 0;
    property <float> side-sign: root.rtl ? -1 : 1;
    // The cell pressed under the pointer, -1 for a gap, the centre or no
    // press (S-017: it takes the press scale). Set from the touch handlers
    // below: `pick` is a callback and cannot run in a binding.
    property <int> pressed-cell: -1;

    if root.x11-plate: plate := Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        background: Tokens.surface-0;
        accessible-role: none;
    }

    layer := Rectangle {
        visible: !root.stage-two;
        // The close (S-017c): the whole hive fades to
        // `Tokens.hive-close-opacity-to` and shrinks to
        // `Tokens.hive-close-scale-to` over `Tokens.hive-close`. Only
        // entering the closing state animates, so the reset at the next
        // show is instant.
        opacity: 1;
        transform-scale: 1;
        states [
            closing when root.closing: {
                layer.opacity: Tokens.hive-close-opacity-to;
                layer.transform-scale: Tokens.hive-close-scale-to;
                in {
                    animate opacity, transform-scale {
                        duration: Tokens.hive-close;
                        easing: Tokens.hive-close-easing;
                    }
                }
            }
        ]

        // Several files: two hexagons behind the centre, up and to the side,
        // under the action cells too.
        if root.preview-count > 2: stack-2 := HexCell {
            x: root.centre-x + root.side-sign * 2 * Tokens.hex-stack-offset - self.width / 2;
            y: root.centre-y - 2 * Tokens.hex-stack-offset - self.height / 2;
            r: root.hex-r;
            ring: 0;
            opened: root.opened;
            glass: root.glass;
            accessible-role: none;
        }

        if root.preview-count > 1: stack-1 := HexCell {
            x: root.centre-x + root.side-sign * Tokens.hex-stack-offset - self.width / 2;
            y: root.centre-y - Tokens.hex-stack-offset - self.height / 2;
            r: root.hex-r;
            ring: 0;
            opened: root.opened;
            glass: root.glass;
            accessible-role: none;
        }

        // The cells' fills, under the sliding accent highlight.
        for cell[i] in root.cells: cell-hex := HexCell {
            x: cell.x - self.width / 2;
            y: cell.y - self.height / 2;
            r: root.hex-r;
            ring: cell.ring;
            opened: root.opened;
            pressed: i == root.pressed-cell;
            glass: root.glass;
            highlighted: i == root.highlight;
            enabled: cell.enabled;
            draw-label: false;
            accessible-role: button;
            accessible-label: cell.label;
            accessible-action-default => {
                root.choose(i);
            }
        }

        // One accent highlight slides between cell centres (S-017): for the
        // mouse, the keyboard and the drop drag. Its first appearance is in
        // place and leaving all cells hides it in place; between two cells
        // `animate x, y` moves it over `Tokens.highlight-move`.
        if root.highlight >= 0 && root.cells[root.highlight].enabled: highlight := HexCell {
            x: root.cells[root.highlight].x - self.width / 2;
            y: root.cells[root.highlight].y - self.height / 2;
            r: root.hex-r;
            highlighted: true;
            opened: true;
            draw-label: false;
            animate x, y {
                duration: Tokens.highlight-move;
                easing: Tokens.highlight-move-easing;
            }
            accessible-role: none;
        }

        // The cells' labels, over the sliding highlight.
        for cell[i] in root.cells: cell-label := HexCell {
            x: cell.x - self.width / 2;
            y: cell.y - self.height / 2;
            r: root.hex-r;
            text: cell.code;
            icon: cell.icon;
            has-icon: cell.has-icon;
            highlighted: i == root.highlight;
            enabled: cell.enabled;
            ring: cell.ring;
            opened: root.opened;
            pressed: i == root.pressed-cell;
            draw-fill: false;
            accessible-role: none;
        }

        centre := HexCell {
            x: root.centre-x - self.width / 2;
            y: root.centre-y - self.height / 2;
            r: root.hex-r;
            centre: true;
            ring: 0;
            opened: root.opened;
            glass: root.glass;
            text: root.centre-shown;
            accessible-role: text;
            accessible-label: root.centre-label;
        }

        // The preview picture and the count badge fade in with the centre
        // (ring 0).
        extras := Rectangle {
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;
            opacity: 0;
            states [
                open when root.opened: {
                    extras.opacity: 1;
                    in {
                        animate opacity {
                            duration: Tokens.hive-open;
                            easing: Tokens.hive-open-easing;
                        }
                    }
                }
            ]

            // The thumbnail fills the inscribed square; the kind icon sits
            // in it above the format code. A hover shows the name instead.
            if root.preview-count > 0 && !root.hovering: VerticalLayout {
                x: root.centre-x - root.preview-side / 2;
                y: root.centre-y - root.preview-side / 2;
                width: root.preview-side;
                height: root.preview-side;
                alignment: center;
                spacing: Tokens.hex-icon-gap;

                preview := Image {
                    height: root.has-thumb ? root.preview-side : Tokens.hex-preview-icon-size;
                    source: root.has-thumb ? root.preview-image : root.preview-icon;
                    image-fit: contain;
                    colorize: root.has-thumb ? transparent : Tokens.hex-ink;
                    accessible-role: none;
                }

                if !root.has-thumb: Text {
                    horizontal-alignment: center;
                    overflow: elide;
                    text: root.preview-code;
                    font-size: Tokens.font-body;
                    font-weight: Tokens.weight-semibold;
                    color: Tokens.hex-ink;
                    accessible-role: none;
                }
            }

            // The reason and the suggestion, under the preview, with the
            // centre's open (ring 0). A hover shows the cell's name instead.
            if root.centre-message != "": message := Text {
                x: root.centre-x - root.hex-r * 0.75;
                y: root.centre-y + root.preview-side / 2 + Tokens.space-1;
                width: root.hex-r * 1.5;
                horizontal-alignment: center;
                wrap: word-wrap;
                overflow: elide;
                text: root.centre-message;
                font-size: Tokens.font-label;
                color: Tokens.text-secondary;
                opacity: root.hovering ? 0 : 1;
                accessible-role: text;
                accessible-label: root.centre-message;
            }

            if root.centre-suggestion != "": suggestion := Text {
                x: root.centre-x - root.hex-r * 0.75;
                y: root.centre-y + root.preview-side / 2 + Tokens.space-1 + (root.centre-message != "" ? 2 * Tokens.font-label : 0);
                width: root.hex-r * 1.5;
                horizontal-alignment: center;
                overflow: elide;
                text: root.centre-suggestion;
                font-size: Tokens.font-label;
                font-weight: Tokens.weight-semibold;
                color: Tokens.hex-ink;
                opacity: root.hovering ? 0 : 1;
                accessible-role: text;
                accessible-label: root.centre-suggestion;
            }

            // The number of files, on the square's upper corner at the stack
            // side.
            if root.preview-count > 1: badge := Rectangle {
                width: max(Tokens.hex-badge-size, count.preferred-width + 2 * Tokens.space-1);
                height: Tokens.hex-badge-size;
                x: root.centre-x + root.side-sign * root.preview-side / 2 - self.width / 2;
                y: root.centre-y - root.preview-side / 2 - self.height / 2;
                border-radius: self.height / 2;
                background: Tokens.accent;

                count := Text {
                    width: parent.width;
                    height: parent.height;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    text: root.preview-count;
                    font-size: Tokens.font-label;
                    font-weight: Tokens.weight-semibold;
                    color: Tokens.accent-ink;
                    accessible-role: none;
                }
            }
        }
    }

    touch := TouchArea {
        // `moved` only fires while pressed; hover needs the position itself.
        // The press state follows the pointer, so leaving the pressed cell
        // returns it to 1 (S-017 AC6). Disabled while the panel is open, so
        // the panel's controls get the pointer.
        enabled: !root.stage-two;
        changed mouse-x => {
            root.highlight = root.pick(self.mouse-x, self.mouse-y);
            root.pressed-cell = self.pressed ? root.pick(self.mouse-x, self.mouse-y) : -1;
            root.update-hint(root.highlight);
        }
        changed mouse-y => {
            root.highlight = root.pick(self.mouse-x, self.mouse-y);
            root.pressed-cell = self.pressed ? root.pick(self.mouse-x, self.mouse-y) : -1;
            root.update-hint(root.highlight);
        }
        changed pressed => {
            root.pressed-cell = self.pressed ? root.pick(self.mouse-x, self.mouse-y) : -1;
        }
        changed has-hover => {
            if !self.has-hover {
                root.highlight = -1;
                root.pressed-cell = -1;
                root.update-hint(-1);
            }
        }
        clicked => {
            if root.pick(self.pressed-x, self.pressed-y) >= 0 {
                root.choose(root.pick(self.pressed-x, self.pressed-y));
            } else {
                root.dismiss();
            }
        }
    }

    // S-119: the customize pill, under the centre label. It sits above the
    // pointer catcher so it can be clicked, and it is the door to stage 2 on
    // every backend.
    pill := Rectangle {
        visible: root.hint-visible && !root.stage-two;
        x: root.centre-x - self.width / 2;
        y: root.centre-y + root.preview-side / 2 + Tokens.space-2;
        height: Tokens.space-5 + Tokens.space-1;
        width: pill-text.preferred-width + 2 * Tokens.space-3;
        background: Tokens.surface-2;
        border-radius: Tokens.radius-lg;
        border-width: Tokens.border-default;
        border-color: Tokens.border;
        accessible-role: button;
        accessible-label: root.customize-hint;

        pill-text := Text {
            width: 100%;
            height: 100%;
            text: root.customize-hint;
            font-size: Tokens.font-label;
            color: Tokens.text-primary;
            horizontal-alignment: center;
            vertical-alignment: center;
            accessible-role: none;
        }

        pill-touch := TouchArea {
            width: 100%;
            height: 100%;
            clicked => {
                if (root.hinted-cell >= 0) {
                    root.customize(root.hinted-cell);
                }
            }
            accessible-role: button;
            accessible-label: root.customize-hint;
            accessible-action-default => {
                if (root.hinted-cell >= 0) {
                    root.customize(root.hinted-cell);
                }
            }
        }
    }

    // S-119 stage 2: the option panel, inside the same window. Every control
    // is a vendored Material 3 component; every colour, length and radius is
    // a design token. The panel draws only after the user asks for it, so the
    // first hive frame is untouched.
    if root.stage-two && !root.closing: panel := Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        background: Tokens.surface-3;
        border-width: Tokens.border-default;
        border-color: Tokens.border;
        border-radius: Tokens.radius-lg;

        property <length> pad: Tokens.space-4;
        property <length> content-w: root.width - 2 * self.pad;
        property <length> title-h: Tokens.font-title + Tokens.space-2;
        property <length> row-h: 2 * Tokens.space-5 - Tokens.space-1;
        property <length> footer-h: Tokens.space-7;
        property <length> body-y: self.pad + self.title-h + Tokens.space-2;
        property <length> preset-h: root.stage-presets.length > 0 ? Tokens.space-7 : 0;
        property <length> body-h: root.height - self.body-y - self.footer-h - self.preset-h - self.pad;
        property <length> well-r: Tokens.layout-stage-well-r;
        property <length> well-w: self.well-r * 1.7320508;
        property <length> well-h: self.well-r * 2;
        property <length> well-x: root.rtl ? root.width - self.pad - self.well-w : self.pad;
        property <length> opt-w: self.content-w - self.well-w - Tokens.space-4;
        property <length> opt-x: root.rtl ? self.pad : root.width - self.pad - self.opt-w;
        property <length> label-w: Tokens.layout-stage-label-w;
        property <length> ctl-w: self.opt-w - self.label-w - Tokens.space-1;
        property <length> ctl-x: root.rtl ? 0 : self.label-w + Tokens.space-1;

        Text {
            x: panel.pad;
            y: panel.pad;
            width: panel.content-w;
            height: panel.title-h;
            text: root.stage-title;
            font-size: Tokens.font-title;
            font-weight: Tokens.weight-semibold;
            color: Tokens.text-primary;
            vertical-alignment: center;
            overflow: elide;
            horizontal-alignment: root.rtl ? right : left;
            accessible-role: text;
            accessible-label: root.stage-title;
        }

        // The picture well: a pointy top hexagon, with the masked draft over
        // it once the worker has one.
        well := Path {
            x: panel.well-x;
            y: panel.body-y;
            width: panel.well-w;
            height: panel.well-h;
            viewbox-width: 1.7320508;
            viewbox-height: 2;
            commands: "M 0.8660254 0 L 1.7320508 0.5 L 1.7320508 1.5 L 0.8660254 2 L 0 1.5 L 0 0.5 Z";
            fill: Tokens.surface-0;
            stroke: Tokens.border;
            stroke-width: Tokens.border-default;
            accessible-role: none;
        }
        if root.stage-preview: stage-image := Image {
            x: panel.well-x;
            y: panel.body-y;
            width: panel.well-w;
            height: panel.well-h;
            source: root.stage-preview-image;
            image-fit: cover;
            accessible-role: image;
            accessible-label: root.stage-readout;
        }
        readout := Text {
            x: panel.well-x;
            y: panel.body-y + panel.well-h + Tokens.space-2;
            width: panel.well-w;
            height: panel.body-h - panel.well-h - Tokens.space-2;
            text: root.stage-readout;
            font-size: Tokens.font-label;
            color: Tokens.text-secondary;
            wrap: word-wrap;
            horizontal-alignment: root.rtl ? right : left;
            accessible-role: text;
            accessible-label: root.stage-readout;
        }
        if root.stage-preview-note != "": preview-note := Text {
            x: panel.well-x;
            y: panel.body-y + panel.well-h + Tokens.space-2 + 2 * Tokens.font-label;
            width: panel.well-w;
            height: Tokens.font-label;
            text: root.stage-preview-note;
            font-size: Tokens.font-label;
            color: Tokens.text-secondary;
            overflow: elide;
            horizontal-alignment: root.rtl ? right : left;
            accessible-role: text;
            accessible-label: root.stage-preview-note;
        }

        // One row per option field, in the schema order.
        options := ScrollView {
            x: panel.opt-x;
            y: panel.body-y;
            width: panel.opt-w;
            height: panel.body-h;
            content-width: self.visible-width;
            content-height: max(self.visible-height, rows-layout.preferred-height);

            rows-layout := VerticalLayout {
                width: options.visible-width;
                spacing: Tokens.space-1;

                for opt[i] in root.stage-options: row := Rectangle {
                    height: opt.kind == StageKind.Enum ? max(panel.row-h, panel.row-h + (opt.choices.length - 1) * Tokens.space-6) : panel.row-h;
                    width: rows-layout.width;
                    background: transparent;

                    if opt.kind != StageKind.Text: label := Text {
                        x: root.rtl ? parent.width - self.width : 0;
                        width: panel.label-w;
                        height: opt.kind == StageKind.Enum ? panel.row-h : parent.height;
                        text: opt.label + ": " + opt.display;
                        font-size: Tokens.font-label;
                        color: Tokens.text-primary;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-alignment: root.rtl ? right : left;
                        accessible-role: none;
                    }

                    if opt.kind == StageKind.Bool: CheckBox {
                        x: panel.ctl-x;
                        width: panel.ctl-w;
                        height: parent.height;
                        check_state: opt.value > 0.5 ? CheckState.checked : CheckState.unchecked;
                        checked_state_changed(state) => {
                            root.option-changed(i, state == CheckState.checked ? 1 : 0, "");
                        }
                        accessible-label: opt.label + ": " + opt.display;
                    }

                    if opt.kind == StageKind.Number: VerticalLayout {
                        x: panel.ctl-x;
                        width: panel.ctl-w;
                        height: parent.height;
                        alignment: center;
                        spacing: 0;
                        Slider {
                            minimum: opt.min;
                            maximum: opt.max;
                            stop_count: opt.step > 0 ? round((opt.max - opt.min) / opt.step) : 0;
                            value: opt.value;
                            value_changed(value) => {
                                root.option-changed(i, value, "");
                            }
                            accessible-label: opt.label + ": " + opt.display;
                        }
                        Text {
                            text: opt.display;
                            font-size: Tokens.font-label;
                            color: Tokens.text-secondary;
                            horizontal-alignment: root.rtl ? right : left;
                            accessible-role: none;
                        }
                    }

                    if opt.kind == StageKind.Enum: VerticalLayout {
                        x: panel.ctl-x;
                        width: panel.ctl-w;
                        height: parent.height;
                        spacing: 0;
                        alignment: start;
                        for choice[c] in opt.choices: HorizontalLayout {
                            spacing: Tokens.space-1;
                            RadioButton {
                                checked: opt.selected == c;
                                clicked => {
                                    root.option-changed(i, c, choice.text);
                                }
                                accessible-label: choice.text;
                            }
                            Text {
                                text: choice.text;
                                font-size: Tokens.font-label;
                                color: Tokens.text-primary;
                                vertical-alignment: center;
                                overflow: elide;
                                accessible-role: none;
                            }
                        }
                    }

                    if opt.kind == StageKind.Text: TextField {
                        x: 0;
                        width: parent.width;
                        height: parent.height;
                        text: opt.text;
                        label: opt.label;
                        edited(text) => {
                            root.option-changed(i, 0, text);
                        }
                        accessible-label: opt.label + ": " + opt.text;
                    }
                }
            }
        }

        // The resolved values failed: say so and keep the panel open.
        if root.stage-error != "": stage-error-text := Text {
            x: panel.pad;
            y: root.height - panel.pad - panel.footer-h - Tokens.font-label - Tokens.space-1;
            width: panel.content-w;
            height: Tokens.font-label;
            text: root.stage-error;
            font-size: Tokens.font-label;
            color: Tokens.danger;
            overflow: elide;
            horizontal-alignment: root.rtl ? right : left;
            accessible-role: text;
            accessible-label: root.stage-error;
        }

        // Presets, from the action's [action.options.preset] data.
        if root.stage-presets.length > 0: HorizontalLayout {
            x: panel.pad;
            y: panel.body-y + panel.body-h + Tokens.space-1;
            width: panel.content-w;
            height: panel.preset-h;
            spacing: Tokens.space-1;
            alignment: start;
            for preset[p] in root.stage-presets: FilterChip {
                text: preset.label;
                checked: false;
                changed checked => {
                    if (self.checked) {
                        root.preset-picked(p);
                        self.checked = false;
                    }
                }
                accessible-label: preset.label;
            }
        }

        // The footer: Run, Reset, Back, mirrored for Arabic.
        if root.rtl: HorizontalLayout {
            x: panel.pad;
            y: root.height - panel.pad - panel.footer-h;
            width: panel.content-w;
            height: panel.footer-h;
            spacing: Tokens.space-2;
            alignment: end;
            TextButton {
                text: root.stage-back-text;
                clicked => { root.stage-cancel(); }
            }
            TextButton {
                text: root.stage-reset-text;
                clicked => { root.stage-reset(); }
            }
            FilledButton {
                text: root.stage-run-text;
                clicked => { root.stage-run(); }
            }
        }
        if !root.rtl: HorizontalLayout {
            x: panel.pad;
            y: root.height - panel.pad - panel.footer-h;
            width: panel.content-w;
            height: panel.footer-h;
            spacing: Tokens.space-2;
            alignment: start;
            FilledButton {
                text: root.stage-run-text;
                clicked => { root.stage-run(); }
            }
            TextButton {
                text: root.stage-reset-text;
                clicked => { root.stage-reset(); }
            }
            TextButton {
                text: root.stage-back-text;
                clicked => { root.stage-cancel(); }
            }
        }
    }

    keys := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape && root.stage-two {
                root.stage-cancel();
                return accept;
            }
            if root.stage-two {
                return reject;
            }
            if event.text == Key.Escape {
                root.dismiss();
                return accept;
            }
            if event.text == Key.Return && event.modifiers.shift {
                if root.highlight >= 0 && root.highlight < root.cells.length {
                    if root.cells[root.highlight].customize {
                        root.customize(root.highlight);
                        return accept;
                    }
                }
            }
            if event.text == Key.Return || event.text == Key.Space {
                if root.highlight >= 0 {
                    root.choose(root.highlight);
                }
                return accept;
            }
            if event.text == Key.Backtab || (event.text == Key.Tab && event.modifiers.shift) {
                root.highlight = root.navigate(root.highlight, 1);
                return accept;
            }
            if event.text == Key.Tab {
                root.highlight = root.navigate(root.highlight, 0);
                return accept;
            }
            if event.text == Key.LeftArrow {
                root.highlight = root.navigate(root.highlight, 2);
                return accept;
            }
            if event.text == Key.RightArrow {
                root.highlight = root.navigate(root.highlight, 3);
                return accept;
            }
            if event.text == Key.UpArrow {
                root.highlight = root.navigate(root.highlight, 4);
                return accept;
            }
            if event.text == Key.DownArrow {
                root.highlight = root.navigate(root.highlight, 5);
                return accept;
            }
            reject
        }
    }
}
