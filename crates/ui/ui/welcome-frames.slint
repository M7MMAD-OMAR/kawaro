// The demonstration scene of the welcome window (S-087), rendered once by
// scripts/gen-welcome-frames.sh into the frame set of
// crates/ui/resources/welcome/. The hive is drawn with the same hex cell
// component the real hive uses, so the frames show the hive users will
// really see. No text is drawn here: the caption steps live in the window
// and are filled from Rust in the user's language.
import { Tokens } from "tokens.slint";
import { Palette } from "std-widgets.slint";
import { HexCell } from "../components/hex-cell.slint";

export { Tokens, Palette }

// The flow of one conversion over 16 frames: a file is dragged out of the
// file manager (0 to 2), the trigger is activated (3 to 5), the hive appears
// at the pointer or centred, matching the platform (6 to 11), the file is
// dropped on a cell (12) and the result appears beside the untouched
// original while the hive fades (13 to 15).
component DemoScene inherits Rectangle {
    in property <int> frame;
    // The window path shows the hive centred; the layer, X11 and Windows
    // paths show it at the pointer (S-087 AC2).
    in property <bool> centred;

    background: Tokens.surface-0;

    property <float> f: root.frame;
    property <bool> dragging: root.frame >= 2 && root.frame <= 12;
    property <bool> triggering: root.frame >= 3 && root.frame <= 5;
    property <bool> hive-shown: root.frame >= 6 && root.frame <= 15;
    property <bool> landed: root.frame >= 12;
    property <bool> result-shown: root.frame >= 13;
    property <float> hive-fade: root.frame <= 12 ? 1.0 : (root.frame == 13 ? 0.6 : (root.frame == 14 ? 0.3 : 0.0));
    property <float> result-in: root.frame <= 12 ? 0.0 : min(1.0, (root.f - 12.0));

    // The hexagon lattice of the hive cluster: one centre cell and its ring.
    property <length> hex-r: Tokens.hex-sm;
    property <length> hex-step: Tokens.hex-sm * 1.7320508 + Tokens.hex-gap;

    // Where the hive sits and where the drop lands.
    property <length> hive-x: root.centred ? root.width * 0.5 : root.width * 0.68;
    property <length> hive-y: root.centred ? root.height * 0.5 : root.height * 0.42;
    property <length> drop-x: root.hive-x + (root.centred ? -root.hex-step * 0.5 : root.hex-step);
    property <length> drop-y: root.hive-y + (root.centred ? root.hex-step * 0.866 : root.hex-step * 0);

    // The pointer path: out of the file manager toward the drop cell.
    property <length> pointer-x: root.width * 0.3 + (root.drop-x - root.width * 0.3) * min(1.0, max(0.0, (root.f - 2.0) / 10.0));
    property <length> pointer-y: root.height * 0.62 + (root.drop-y - root.height * 0.62) * min(1.0, max(0.0, (root.f - 2.0) / 10.0));

    // The file manager window the file is dragged out of.
    panel := Rectangle {
        x: Tokens.space-5;
        y: Tokens.space-5;
        width: root.width * 0.42;
        height: root.height - Tokens.space-5 * 2;
        background: Tokens.surface-1;
        border-color: Tokens.border;
        border-width: Tokens.border-default;
        border-radius: Tokens.radius-md;
        clip: true;

        header := Rectangle {
            x: 0;
            y: 0;
            width: 100%;
            height: Tokens.space-6 + Tokens.space-2;
            background: Tokens.surface-2;

            dot := Rectangle {
                x: Tokens.space-3;
                y: (parent.height - self.height) / 2;
                width: Tokens.space-2;
                height: Tokens.space-2;
                background: Tokens.border;
                border-radius: self.width / 2;
            }
        }

        // The original file card, untouched through the whole flow.
        original := Rectangle {
            x: Tokens.space-3;
            y: header.y + header.height + Tokens.space-4;
            width: (parent.width - Tokens.space-3 * 3) / 2;
            height: parent.height - header.height - Tokens.space-4 * 2;
            background: Tokens.surface-0;
            border-color: Tokens.border;
            border-width: Tokens.border-default;
            border-radius: Tokens.radius-md;

            thumb := Image {
                x: Tokens.space-2;
                y: Tokens.space-2;
                width: parent.width - Tokens.space-2 * 2;
                height: parent.height - Tokens.space-5 - Tokens.space-2 * 2;
                source: @image-url("../../../tests/fixtures/images/welcome-sample.png");
            }

            orig-name := Rectangle {
                x: Tokens.space-2;
                y: parent.height - Tokens.space-4;
                width: parent.width * 0.7;
                height: Tokens.space-2;
                background: Tokens.text-secondary;
                border-radius: self.height / 2;
                opacity: 0.5;
            }
        }

        // The result appears beside the original after the drop (S-087 AC2).
        result := Rectangle {
            x: Tokens.space-3 * 2 + original.width;
            y: original.y;
            width: original.width;
            height: original.height;
            background: Tokens.surface-0;
            border-color: Tokens.border;
            border-width: Tokens.border-default;
            border-radius: Tokens.radius-md;
            opacity: root.result-in;
            transform-scale: 0.85 + 0.15 * root.result-in;

            badge := Rectangle {
                x: (parent.width - self.width) / 2;
                y: Tokens.space-2;
                width: Tokens.hex-badge-size;
                height: Tokens.hex-badge-size;
                background: Tokens.success;
                border-radius: self.width / 2;
                opacity: root.result-in;
            }

            result-name := Rectangle {
                x: Tokens.space-2;
                y: parent.height - Tokens.space-4;
                width: parent.width * 0.7;
                height: Tokens.space-2;
                background: Tokens.text-secondary;
                border-radius: self.height / 2;
                opacity: 0.5;
            }
        }
    }

    // The hive, drawn from the real hex cell component, fading after the
    // drop so the loop returns to its start.
    hive := Rectangle {
        width: 0;
        height: 0;
        opacity: root.hive-fade;

        centre := HexCell {
            x: root.hive-x - self.width / 2;
            y: root.hive-y - self.height / 2;
            r: root.hex-r;
            opened: root.hive-shown;
            centre: true;
            ring: 0;
        }

        c-e := HexCell {
            x: root.hive-x + root.hex-step - self.width / 2;
            y: root.hive-y - self.height / 2;
            r: root.hex-r;
            text: "WEBP";
            opened: root.hive-shown;
            ring: 1;
            highlighted: root.frame >= 8 && !root.centred;
            pressed: root.landed && !root.centred;
        }

        c-w := HexCell {
            x: root.hive-x - root.hex-step - self.width / 2;
            y: root.hive-y - self.height / 2;
            r: root.hex-r;
            text: "PDF";
            opened: root.hive-shown;
            ring: 1;
            highlighted: root.frame >= 8 && root.centred;
            pressed: root.landed && root.centred;
        }

        c-ne := HexCell {
            x: root.hive-x + root.hex-step * 0.5 - self.width / 2;
            y: root.hive-y - root.hex-step * 0.866 - self.height / 2;
            r: root.hex-r;
            text: "PNG";
            opened: root.hive-shown;
            ring: 1;
        }

        c-nw := HexCell {
            x: root.hive-x - root.hex-step * 0.5 - self.width / 2;
            y: root.hive-y - root.hex-step * 0.866 - self.height / 2;
            r: root.hex-r;
            text: "GIF";
            opened: root.hive-shown;
            ring: 1;
        }

        c-se := HexCell {
            x: root.hive-x + root.hex-step * 0.5 - self.width / 2;
            y: root.hive-y + root.hex-step * 0.866 - self.height / 2;
            r: root.hex-r;
            text: "JPG";
            opened: root.hive-shown;
            ring: 1;
        }

        c-sw := HexCell {
            x: root.hive-x - root.hex-step * 0.5 - self.width / 2;
            y: root.hive-y + root.hex-step * 0.866 - self.height / 2;
            r: root.hex-r;
            text: "SVG";
            opened: root.hive-shown;
            ring: 1;
        }
    }

    // The dragged file, following the pointer while the drag runs.
    ghost := Rectangle {
        x: root.pointer-x + Tokens.space-3;
        y: root.pointer-y + Tokens.space-3;
        width: Tokens.space-6 + Tokens.space-2;
        height: Tokens.space-6;
        background: Tokens.surface-2;
        border-color: Tokens.border;
        border-width: Tokens.border-default;
        border-radius: Tokens.radius-sm;
        opacity: root.dragging && !root.landed ? 1.0 : 0.0;

        Image {
            x: Tokens.space-1;
            y: Tokens.space-1;
            width: parent.width - Tokens.space-1 * 2;
            height: parent.height - Tokens.space-1 * 2;
            source: @image-url("../../../tests/fixtures/images/welcome-sample.png");
        }
    }

    // The trigger moment: three accent points trail the pointer (frames 3
    // to 5), with no key drawn, since the captions name the trigger.
    trail := Rectangle {
        x: root.pointer-x - Tokens.space-3;
        y: root.pointer-y + Tokens.space-2;
        width: 0;
        height: 0;
        opacity: root.triggering ? 1.0 : 0.0;

        p1 := Rectangle {
            x: -Tokens.space-2 * 2;
            y: 0;
            width: Tokens.space-2;
            height: Tokens.space-2;
            background: Tokens.accent;
            border-radius: self.width / 2;
            opacity: 0.9;
        }

        p2 := Rectangle {
            x: -Tokens.space-2 * 4;
            y: Tokens.space-1;
            width: Tokens.space-2;
            height: Tokens.space-2;
            background: Tokens.accent;
            border-radius: self.width / 2;
            opacity: 0.6;
        }

        p3 := Rectangle {
            x: -Tokens.space-2 * 6;
            y: Tokens.space-2;
            width: Tokens.space-2;
            height: Tokens.space-2;
            background: Tokens.accent;
            border-radius: self.width / 2;
            opacity: 0.3;
        }
    }

    // The pointer itself.
    pointer := Path {
        x: root.pointer-x;
        y: root.pointer-y;
        width: Tokens.space-3;
        height: Tokens.space-4;
        viewbox-width: 12;
        viewbox-height: 19;
        stroke: Tokens.surface-0;
        stroke-width: Tokens.border-default / 2;
        fill: Tokens.text-primary;
        commands: "M 1 1 L 1 15 L 4.5 12 L 7 18 L 9.5 16.5 L 7 11 L 11 11 Z";
    }
}

// The generator's window: exactly one demo frame per snapshot.
export component FramesWindow inherits Window {
    in property <int> frame;
    in property <bool> centred;
    preferred-width: Tokens.space-6 * 18;
    preferred-height: Tokens.space-6 * 18 * 9 / 16;

    DemoScene {
        frame: root.frame;
        centred: root.centred;
        width: 100%;
        height: 100%;
    }
}
