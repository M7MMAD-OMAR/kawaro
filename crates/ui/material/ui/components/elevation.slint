//
// Modified for Kawaro: every drop shadow removed. The component keeps its
// properties so the rest of the library compiles unchanged, but `level` has
// no visual effect; height is shown with surface tones only.

export component Elevation {
    in property <brush> background;
    in property <length> border_radius;
    in property <int> level;

    Rectangle {
        border_radius: root.border_radius;
        background: root.background;

        @children
    }
}
