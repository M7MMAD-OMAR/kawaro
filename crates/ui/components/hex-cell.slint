// The hexagon cell, pointy top. Used for the action cells and the centre.
// The outline is drawn in a unit viewbox scaled to the cell, so no length is
// written here: every size comes from the parent or from Tokens.
import { Tokens } from "tokens.slint";

export component HexCell inherits Rectangle {
    // Circumradius of the hexagon.
    in property <length> r;
    in property <string> text;
    // Drawn above the text when `has-icon`; black-only SVG, coloured here.
    in property <image> icon;
    in property <bool> has-icon;
    in property <bool> highlighted;
    in property <bool> centre;
    // False greys the cell (a skipped file, S-108): the greyed surface and
    // ink, never an opacity.
    in property <bool> enabled: true;
    // S-017 motion and glass. `ring` is the cell's slot ring (0 for the
    // centre and the stack hexagons), so the open of every cell is delayed
    // by `ring * Tokens.ring-delay`. `opened` drives the open; `pressed`
    // shrinks the cell while the pointer is on it; `glass` fills the cell
    // with the glass tokens (only on over a compositor blur). `draw-fill`
    // and `draw-label` split the cell into its fill and its label, so one
    // sliding accent highlight can pass between them (hive.slint).
    in property <int> ring;
    in property <bool> opened;
    in property <bool> pressed;
    in property <bool> glass;
    in property <bool> draw-fill: true;
    in property <bool> draw-label: true;
    // The label size and side padding; the defaults are the hive's. The
    // Introduction film draws smaller cells and passes smaller values.
    in property <length> label-size: Tokens.font-cell;
    in property <length> label-pad: Tokens.space-2;

    width: r * 1.7320508;
    height: r * 2;

    // How far the edge hexagon below reaches past the fill.
    property <length> reach: (2 * Tokens.border-hex - Tokens.border-default) / 2;

    // Open ring by ring (S-017): opacity 0 to 1 and scale 0.92 to 1 over
    // `Tokens.hive-open`, each cell delayed by its ring. Only entering the
    // open state animates, so the reset at every show is instant.
    opacity: 0;
    transform-scale: Tokens.hive-scale-from;
    states [
        open when root.opened: {
            root.opacity: 1;
            root.transform-scale: Tokens.hive-scale-to;
            in {
                animate opacity, transform-scale {
                    delay: root.ring * Tokens.ring-delay;
                    duration: Tokens.hive-open;
                    easing: Tokens.hive-open-easing;
                }
            }
        }
    ]

    // Press (S-017): the cell shrinks to `Tokens.press-scale-to` while the
    // pointer presses it and returns to 1 on release or when it leaves.
    press-wrap := Rectangle {
        width: 100%;
        height: 100%;
        transform-scale: (root.pressed && !Tokens.reduced-motion) ? Tokens.press-scale-to : 1;
        animate transform-scale { duration: Tokens.press; }

        // The edge is `border-hex` wide and lies outside the fill. The fill
        // path below keeps the 1 px outline the cell always had, so the
        // inside of the cell keeps its size and place. A hexagon in the edge
        // colour, larger by the rest of the border on every side, sits under
        // it. With glass it cannot: the fill is translucent and an opaque
        // hexagon under it would make the whole cell opaque (S-017 AC16), so
        // the edge becomes the fill's own stroke and stays opaque.
        if root.draw-fill && !root.glass: Path {
            x: -root.reach;
            y: -root.reach;
            width: parent.width + 2 * root.reach;
            height: parent.height + 2 * root.reach;
            viewbox-width: 1.7320508;
            viewbox-height: 2;
            commands: "M 0.8660254 0 L 1.7320508 0.5 L 1.7320508 1.5 L 0.8660254 2 L 0 1.5 L 0 0.5 Z";
            fill: Tokens.hive-edge;
        }

        if root.draw-fill: Path {
            width: parent.width;
            height: parent.height;
            viewbox-width: 1.7320508;
            viewbox-height: 2;
            commands: "M 0.8660254 0 L 1.7320508 0.5 L 1.7320508 1.5 L 0.8660254 2 L 0 1.5 L 0 0.5 Z";
            fill: root.enabled ? root.live-fill : Tokens.surface-2;
            stroke: Tokens.hive-edge;
            stroke-width: root.glass ? Tokens.border-hex : Tokens.border-default;
            animate fill, stroke { duration: Tokens.hover; }
        }

        // Icon and code, centred together inside the flat sides of the
        // hexagon. The code keeps to one line, so it never runs past the
        // hexagon's points.
        if root.draw-label && root.has-icon: VerticalLayout {
            x: root.label-pad;
            width: parent.width - 2 * root.label-pad;
            height: parent.height;
            alignment: center;
            spacing: Tokens.hex-icon-gap;

            Image {
                height: Tokens.hex-icon-size;
                source: root.icon;
                image-fit: contain;
                colorize: root.enabled ? root.live-ink : Tokens.text-secondary;
                accessible-role: none;
            }

            Text {
                horizontal-alignment: center;
                overflow: elide;
                text: root.text;
                font-size: root.label-size;
                font-weight: Tokens.weight-semibold;
                color: root.enabled ? root.live-ink : Tokens.text-secondary;
                accessible-role: none;
            }
        }

        // No icon, and the centre cell: the text alone, wrapped and centred.
        if root.draw-label && !root.has-icon: Text {
            // Keep text inside the flat sides of the hexagon.
            x: root.label-pad;
            width: parent.width - 2 * root.label-pad;
            height: parent.height;
            horizontal-alignment: center;
            vertical-alignment: center;
            wrap: word-wrap;
            overflow: elide;
            text: root.text;
            font-size: root.label-size;
            font-weight: root.centre ? Tokens.weight-medium : Tokens.weight-semibold;
            color: root.enabled ? root.live-ink : Tokens.text-secondary;
            accessible-role: none;
        }
    }

    property <color> live-ink: root.highlighted ? Tokens.accent-ink : Tokens.hex-ink;
    property <color> live-fill: root.highlighted ? Tokens.accent : (root.centre ? (root.glass ? Tokens.glass-3 : Tokens.hex-fill-centre) : (root.glass ? Tokens.glass-2 : Tokens.hex-fill));
}
