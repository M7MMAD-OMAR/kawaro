-- kawaro:begin
hl.bind("SUPER + Z", hl.dsp.exec_cmd("/usr/bin/kawaro drop --hold --at \"$(hyprctl cursorpos)\""), { non_consuming = true, description = "Kawaro: hold to drop" })
hl.bind("SUPER + Z", hl.dsp.exec_cmd("/usr/bin/kawaro drop --release"), { release = true, non_consuming = true, ignore_mods = true, description = "Kawaro: release to close" })
-- kawaro:end
