// Centre cell preview for ADR 0004: the file itself (thumbnail from the
// freedesktop cache, or its type icon) instead of the text "1 document".
// Spike only: colours are literals here, crates/ui takes them from tokens.

export component PreviewWindow inherits Window {
    in property <image> picture;
    // True for a real thumbnail, false for a type icon (drawn smaller).
    in property <bool> is-thumbnail;
    in property <int> count: 1;
    in property <string> caption;
    // Size of the hexagon, point up.
    in property <length> r: 96px;

    callback dismiss();

    no-frame: true;
    background: transparent;
    title: "SbarHive preview";
    width: r * 1.732 + 40px;
    height: r * 2 + 40px;
    forward-focus: keys;

    // Up to two hexagons behind for several files.
    for i in min(root.count - 1, 2): Path {
        x: 20px + (i + 1) * 8px;
        y: 20px - (i + 1) * 8px;
        width: root.r * 1.732;
        height: root.r * 2;
        viewbox-width: 1.732;
        viewbox-height: 2;
        commands: "M 0.866 0 L 1.732 0.5 L 1.732 1.5 L 0.866 2 L 0 1.5 L 0 0.5 Z";
        fill: #2b2d31;
        stroke: #5a5d63;
        stroke-width: 1px;
    }

    Path {
        x: 20px;
        y: 20px;
        width: root.r * 1.732;
        height: root.r * 2;
        viewbox-width: 1.732;
        viewbox-height: 2;
        commands: "M 0.866 0 L 1.732 0.5 L 1.732 1.5 L 0.866 2 L 0 1.5 L 0 0.5 Z";
        fill: #34363b;
        stroke: #f2b84b;
        stroke-width: 2px;
    }

    // The square inscribed in the hexagon holds the picture.
    Image {
        x: 20px + root.r * 0.866 - self.width / 2;
        y: 20px + root.r - self.height / 2 - (root.caption == "" ? 0 : 10px);
        width: root.is-thumbnail ? root.r * 1.2 : root.r * 0.8;
        height: self.width;
        source: root.picture;
        image-fit: contain;
        accessible-role: image;
        accessible-label: root.caption;
    }

    Text {
        x: 20px;
        y: 20px + root.r * 1.55;
        width: root.r * 1.732;
        horizontal-alignment: center;
        text: root.caption;
        color: #f5f5f5;
        font-size: 13px;
    }

    if root.count > 1: Rectangle {
        x: 20px + root.r * 1.732 - 30px;
        y: 20px + root.r * 0.4;
        width: 30px;
        height: 22px;
        border-radius: 11px;
        background: #f2b84b;
        Text {
            text: root.count;
            color: #1b1b1b;
            font-size: 13px;
            font-weight: 600;
        }
    }

    keys := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.dismiss();
                return accept;
            }
            reject
        }
    }
}
