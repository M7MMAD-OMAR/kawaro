# Kawaro daemon as a systemd user service.
# Install to ~/.config/systemd/user/, then:
#   systemctl --user daemon-reload && systemctl --user enable --now kawaro.service
# scripts/install.sh rewrites ExecStart with the absolute path under PREFIX.
# The session must import WAYLAND_DISPLAY into the user manager, for example:
#   dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP
[Unit]
Description=Kawaro file converter daemon
Documentation=https://github.com/M7MMAD-OMAR/kawaro
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/kawarod
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
