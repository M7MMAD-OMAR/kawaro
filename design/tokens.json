{
  "$description": "Single source of truth for the SbarHive design system. No shadows, no gradients, no one-sided borders. Elevation is expressed with surface tones only.",
  "color": {
    "light": {
      "surface-0": "#FAF7F0",
      "surface-1": "#F2EDE2",
      "surface-2": "#E9E1D0",
      "surface-3": "#DFD3BB",
      "border": "#D2C6AE",
      "text-primary": "#1F1A12",
      "text-secondary": "#5C5446",
      "accent": "#D9921A",
      "accent-ink": "#1F1200",
      "success": "#2F7D4F",
      "warning": "#B7791F",
      "danger": "#B23A31",
      "progress": "#D9921A",
      "hive-plate": "#DFD3BB",
      "hive-edge": "#5C5446",
      "hex-fill": "#FFFFFF",
      "hex-fill-centre": "#FAF7F0",
      "hex-ink": "#1F1A12"
    },
    "dark": {
      "surface-0": "#15130F",
      "surface-1": "#1E1B16",
      "surface-2": "#27231C",
      "surface-3": "#322C23",
      "border": "#3E372C",
      "text-primary": "#F2ECE0",
      "text-secondary": "#B3AA99",
      "accent": "#F0A93B",
      "accent-ink": "#2A1A00",
      "success": "#5DBB83",
      "warning": "#E2A84B",
      "danger": "#E2685E",
      "progress": "#F0A93B",
      "hive-plate": "#1E1B16",
      "hive-edge": "#B3AA99",
      "hex-fill": "#0B0A08",
      "hex-fill-centre": "#15130F",
      "hex-ink": "#F2ECE0"
    }
  },
  "hex": {
    "orientation": "pointy-top",
    "coordinates": "axial",
    "size": { "sm": 56, "md": 72, "lg": 88 },
    "gap": 6,
    "ring-1-count": 6,
    "ring-2-count": 12,
    "label-max-latin-chars": 6,
    "icon-size": 18,
    "icon-gap": 2,
    "preview-icon-size": 24,
    "stack-offset": 4,
    "badge-size": 18
  },
  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 24, "6": 32, "7": 48, "8": 64 },
  "sbarah": {
    "$description": "The owner support badge theme, read from docs/assets/support-sbarah-{dark,light}.svg. Used only by the support section of the site.",
    "dark": { "bg": "#161616", "accent": "#BBD686", "heart": "#B2675E", "text": "#FDFBF7" },
    "light": { "bg": "#F5F0E8", "accent": "#61753D", "heart": "#B2675E", "text": "#37461F" }
  },
  "radius": { "sm": 6, "md": 10, "lg": 14 },
  "border-width": { "default": 1, "focus": 2, "hex": 2 },
  "font": {
    "family": "IBM Plex Sans Arabic",
    "size": { "label": 12, "body": 14, "title": 16, "cell": 14 },
    "weight": { "regular": 400, "medium": 500, "semibold": 600 }
  },
  "motion": {
    "hive-open": { "duration-ms": 120, "scale-from": 0.92, "scale-to": 1, "easing": "ease-out" },
    "hover": { "duration-ms": 80 },
    "respect-reduced-motion": true
  },
  "rules": {
    "box-shadow": false,
    "gradient": false,
    "one-sided-border": false,
    "em-dash": false
  }
}
