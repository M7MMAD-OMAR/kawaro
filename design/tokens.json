{
  "$description": "Single source of truth for the Kawaro design system. No shadows, no gradients, no one-sided borders. Elevation is expressed with surface tones only.",
  "color": {
    "light": {
      "surface-0": "#FAF7F0",
      "surface-1": "#F2EDE2",
      "surface-2": "#E9E1D0",
      "surface-3": "#DFD3BB",
      "border": "#D2C6AE",
      "text-primary": "#1F1A12",
      "text-secondary": "#5C5446",
      "accent": "#D9921A",
      "accent-ink": "#1F1200",
      "success": "#2F7D4F",
      "warning": "#B7791F",
      "danger": "#B23A31",
      "progress": "#D9921A",
      "hive-plate": "#DFD3BB",
      "hive-edge": "#5C5446",
      "hex-fill": "#FFFFFF",
      "hex-fill-centre": "#FAF7F0",
      "hex-ink": "#1F1A12"
    },
    "dark": {
      "surface-0": "#15130F",
      "surface-1": "#1E1B16",
      "surface-2": "#27231C",
      "surface-3": "#322C23",
      "border": "#3E372C",
      "text-primary": "#F2ECE0",
      "text-secondary": "#B3AA99",
      "accent": "#F0A93B",
      "accent-ink": "#2A1A00",
      "success": "#5DBB83",
      "warning": "#E2A84B",
      "danger": "#E2685E",
      "progress": "#F0A93B",
      "hive-plate": "#1E1B16",
      "hive-edge": "#B3AA99",
      "hex-fill": "#0B0A08",
      "hex-fill-centre": "#15130F",
      "hex-ink": "#F2ECE0"
    }
  },
  "glass": {
    "glass-2": {
      "light": "#E9E1D0B8",
      "dark": "#27231CB8"
    },
    "glass-3": {
      "light": "#DFD3BBD1",
      "dark": "#322C23D1"
    }
  },

  "hex": {
    "orientation": "pointy-top",
    "coordinates": "axial",
    "size": { "sm": 56, "md": 72, "lg": 88 },
    "gap": 6,
    "ring-1-count": 6,
    "ring-2-count": 12,
    "label-max-latin-chars": 6,
    "icon-size": 18,
    "icon-gap": 2,
    "preview-icon-size": 24,
    "stack-offset": 4,
    "badge-size": 18
  },
  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 24, "6": 32, "7": 48, "8": 64 },
  "layout": {
    "window-width": 880,
    "window-height": 640,
    "window-min-width": 560,
    "window-min-height": 560,
    "header-height": 64,
    "header-logo": 40,
    "rail-width": 96,
    "content-max-width": 640,
    "row-breakpoint": 520,
    "label-column": 220,
    "film-max-width": 560
  },
  "sbarah": {
    "$description": "The owner support badge theme, read from docs/assets/support-sbarah-{dark,light}.svg. Used only by the support section of the site.",
    "dark": { "bg": "#161616", "accent": "#BBD686", "heart": "#B2675E", "text": "#FDFBF7" },
    "light": { "bg": "#F5F0E8", "accent": "#61753D", "heart": "#B2675E", "text": "#37461F" }
  },
  "radius": { "sm": 6, "md": 10, "lg": 14 },
  "border-width": { "default": 1, "focus": 2, "hex": 2 },
  "font": {
    "family": "IBM Plex Sans Arabic",
    "size": { "label": 12, "body": 14, "title": 16, "cell": 14 },
    "weight": { "regular": 400, "medium": 500, "semibold": 600 }
  },
  "motion": {
    "hive-open": { "duration-ms": 120, "scale-from": 0.92, "scale-to": 1, "easing": "ease-out" },
    "ring-delay-ms": 40,
    "highlight-move": {
      "duration-ms": 140,
      "easing": "cubic-bezier(0.2, 0, 0, 1)"
    },
    "press": {
      "duration-ms": 70,
      "scale-to": 0.94
    },
    "hive-close": {
      "duration-ms": 90,
      "scale-to": 0.96,
      "opacity-to": 0,
      "easing": "ease-in"
    },
    "hover": { "duration-ms": 80 },
    "copied-feedback": { "duration-ms": 2000 },
    "respect-reduced-motion": true
  },
  "rules": {
    "box-shadow": false,
    "gradient": false,
    "one-sided-border": false,
    "em-dash": false
  },
  "site": {
    "$description": "The website's own tokens. Light only, radius 0, big type. scripts/tokens-to-css.py reads only this block. The app keys above are not used by the site.",
    "color": {
      "surface-0": "#FAF7F0",
      "surface-1": "#F2EDE2",
      "surface-2": "#E9E1D0",
      "surface-3": "#DFD3BB",
      "glass-2": "#E9E1D0B8",
      "glass-3": "#DFD3BBD1",
      "paper": "#FFFFFF",
      "border": "#D2C6AE",
      "edge": "#B3A78D",
      "ink": "#1F1A12",
      "text-primary": "#1F1A12",
      "text-secondary": "#5C5446",
      "accent": "#D9921A",
      "accent-soft": "#F6DFAE",
      "accent-ink": "#1F1200",
      "success": "#2F7D4F",
      "warning": "#B7791F",
      "danger": "#B23A31"
    },
    "sbarah": { "bg": "#F5F0E8", "accent": "#61753D", "heart": "#B2675E", "text": "#37461F" },
    "radius": { "none": 0 },
    "space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 24, "6": 32, "7": 48, "8": 64, "9": 96, "10": 128 },
    "border": { "default": 2, "focus": 2, "edge": 2, "ring": 4 },
    "type": {
      "h1": 96, "h2": 64, "h3": 32, "lead": 28, "body": 20, "small": 18,
      "h1-sm": 44, "h2-sm": 36, "h3-sm": 26, "lead-sm": 22, "body-sm": 18,
      "display": 176, "display-sm": 52
    },
    "target": { "min": 56 },
    "hex": { "size-md": 72, "size-lg": 88, "gap": 6 },
    "font": { "family": "IBM Plex Sans Arabic", "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 } },
    "motion": {
      "easing": "cubic-bezier(0.16, 1, 0.3, 1)",
      "easing-steady": "linear",
      "duration-fast": 120,
      "duration-base": 240,
      "duration-slow": 480,
      "duration-stagger": 40,
      "duration-ring-delay": 40,
      "duration-highlight-move": 140,
      "duration-press": 70,
      "duration-hive-close": 90,
      "duration-loop": 10000,
      "duration-marquee": 48000
    },
    "scene": { "length": 5, "select": 0.2, "open": 0.4, "pick": 0.62, "result": 0.84, "ring-step": 0.06, "ramp": 0.1 }
  }
}
